# Copy to .env.local for local development. Never commit real values.

# libSQL / Turso database. Leave unset locally to use the file:local.db fallback.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI coach (server-side only). The app works without them; the coach degrades to 503.
COMMAND_CODE_API_KEY=
COMMAND_CODE_MODEL=
